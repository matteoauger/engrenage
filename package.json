{
    "name": "engrenage",
    "private": true,
    "workspaces": [
        "web",
        "e2e"
    ],
    "devDependencies": {
        "prettier": "^3.10.0"
    },
    "scripts": {
        "bump": "sh scripts/bump.sh",
        "dev:frontend": "npm run dev -w web",
        "dev:backend": "bacon run",
        "build": "npm run build -w web && cargo build",
        "test": "cargo test",
        "test:e2e": "npm run test -w e2e",
        "prettier": "prettier -w .",
        "prettier:check": "prettier -c .",
        "lint": "npm run lint -w web && cargo clippy --all-targets -- -D warnings"
    }
}
